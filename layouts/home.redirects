{{- /* Cloudflare Pages _redirects: one 301 per page alias.
       Each alias is emitted both raw and percent-encoded, with and without a
       trailing slash, so it matches however the edge normalizes the request. */ -}}
# generated by Hugo from page aliases
{{ range site.Pages -}}
{{ $target := .RelPermalink -}}
{{ range .Aliases -}}
{{ $raw := strings.TrimSuffix "/" . -}}
{{ $enc := strings.TrimSuffix "/" (urls.Parse .).EscapedPath -}}
{{ $raw }} {{ $target }} 301
{{ $raw }}/ {{ $target }} 301
{{ if ne $raw $enc -}}
{{ $enc }} {{ $target }} 301
{{ $enc }}/ {{ $target }} 301
{{ end -}}
{{ end -}}
{{ end -}}
